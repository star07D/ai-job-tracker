DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="generate-a-long-random-value-here-min-16-chars"
FRONTEND_URL="http://localhost:3000"
# PORT=4000

# AI interview prep (optional). Free key, no card: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Daily email digest (optional). Free key, no card: https://resend.com/api-keys
# Sends to each user's own account email — no domain verification needed for that.
# RESEND_API_KEY=
# DIGEST_FROM_EMAIL="Rolio <onboarding@resend.dev>"
# Shared secret the digest cron (.github/workflows/email-digest.yml) sends as
# the X-Digest-Secret header. Generate any random string.
# DIGEST_SECRET=

# Google sign-in (optional). Free — no card. Set up an OAuth client at
# https://console.cloud.google.com/apis/credentials (Web application), with
# an authorized redirect URI matching GOOGLE_CALLBACK_URL below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"
