generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String
  createdAt           DateTime       @default(now())
  firstName           String?
  lastName            String?
  emailDigestEnabled  Boolean        @default(false)
  jobs                Job[]
  refreshTokens       RefreshToken[]
}

// One row per issued refresh token, so a session can be revoked (logout,
// rotation) without invalidating every other device's session.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Job {
  id               String    @id @default(cuid())
  title            String
  company          String
  status           String
  userId           String
  createdAt        DateTime  @default(now())
  appliedDate      DateTime  @default(now())
  statusChangedAt  DateTime  @default(now())
  location         String?
  notes            String?
  salary           String?
  prep             Json?
  prepGeneratedAt  DateTime?
  nextAction       String?
  nextActionDue    DateTime?
  contactName      String?
  contactEmail     String?
  contactLinkedin  String?
  tags             String[]  @default([])
  archived         Boolean   @default(false)
  archivedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
