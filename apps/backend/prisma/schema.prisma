generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  // Null for accounts that only ever signed in with Google.
  password            String?
  // Set once a Google sign-in has been linked to this account (verified by
  // Google, so it's safe to auto-link an existing password account by email).
  googleId            String?        @unique
  createdAt           DateTime       @default(now())
  firstName           String?
  lastName            String?
  emailDigestEnabled  Boolean        @default(false)
  // Non-null while a public, read-only share link is turned on for this
  // account — the token is what's in the /share/:token URL.
  shareToken          String?        @unique
  jobs                Job[]
  refreshTokens       RefreshToken[]
}

// One row per issued refresh token, so a session can be revoked (logout,
// rotation) without invalidating every other device's session.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Job {
  id               String    @id @default(cuid())
  title            String
  company          String
  status           String
  userId           String
  createdAt        DateTime  @default(now())
  appliedDate      DateTime  @default(now())
  statusChangedAt  DateTime  @default(now())
  location         String?
  notes            String?
  salary           String?
  prep             Json?
  prepGeneratedAt  DateTime?
  nextAction       String?
  nextActionDue    DateTime?
  contactName      String?
  contactEmail     String?
  contactLinkedin  String?
  tags             String[]  @default([])
  archived         Boolean   @default(false)
  archivedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusEvents     StatusEvent[]
}

// One row per status transition, so the Insights page can see the path a job
// took (not just where it ended up). fromStatus is null when the origin is
// unknown — a job created in its current status, or history backfilled before
// this table existed — and the maths treats those rows as "path unknown".
model StatusEvent {
  id         String   @id @default(cuid())
  jobId      String
  fromStatus String?
  toStatus   String
  at         DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
